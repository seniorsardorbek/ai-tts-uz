PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=coddyjuniorms

GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_GRADING_MODEL=gemini-3.5-flash
# used when the primary model is overloaded (503) or retired (404)
# (gemini-2.5-* are 404 "no longer available to new users" on new keys)
GEMINI_GRADING_MODEL_FALLBACK=gemini-3.1-flash-lite

# set on the server (behind nginx) to offload cache HITs via X-Accel-Redirect
# X_ACCEL_CACHE=1
# optional override of the on-disk cache dir
# CACHE_DIR=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://juniorit.vercel.app,https://go.junior-it.uz

# Admin login (gates the React admin UI). One user is seeded from these on first boot
# (only when the admin_users table is empty). AUTH_SECRET signs the login JWT.
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
